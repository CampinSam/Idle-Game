  updatedAt          DateTime              @updatedAt
  rateSnapshot       Json?
  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, paymentMethod])
  @@index([stripeSessionId])
  @@map("purchases")
}

model CryptoRateConfig {
