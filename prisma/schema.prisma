model AdminRole {
  id              String         @id
  name            String
  slug            String         @unique
  permissionFlags Json           @default("{}") @map("permission_flags")
  isBuiltIn       Boolean        @default(true) @map("is_built_in")
  createdAt       DateTime       @default(now()) @map("created_at")
  accounts        AdminAccount[]

  @@map("admin_roles")
}

model AdminAccount {
  id                     String          @id @default(uuid())
  username               String          @unique
  passwordHash           String          @map("password_hash")
  roleId                 String          @map("role_id")
  contentScopes          String[]        @map("content_scopes")
  permissionFlagsOverride Json           @default("{}") @map("permission_flags_override")
  enabled                Boolean         @default(true)
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")
  role                   AdminRole       @relation(fields: [roleId], references: [id])
  auditLogs              AdminAuditLog[]
  authoredDrafts         ContentDraft[]  @relation("DraftAuthor")
  reviewedDrafts         ContentDraft[]  @relation("DraftReviewer")

  @@index([roleId])
  @@map("admin_accounts")
}

model AdminAuditLog {
  id        BigInt        @id @default(autoincrement())
  adminId   String?       @map("admin_id")
  action    String
  tableName String?       @map("table_name")
  recordId  String?       @map("record_id")
  diff      Json?
  metadata  Json          @default("{}")
  createdAt DateTime      @default(now()) @map("created_at")
  admin     AdminAccount? @relation(fields: [adminId], references: [id])

  @@index([adminId, createdAt(sort: Desc)])
  @@index([tableName, createdAt(sort: Desc)])
  @@map("admin_audit_logs")
}

model GameDefinition {
  id        String    @id @default(cuid())
  type      String
  key       String
  version   Int       @default(1)
  data      Json
  isActive  Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([type, key, version])
  @@index([type, key, isActive])
  @@map("game_definitions")
}

model ContentDraft {
  id            String                @id @default(uuid())
  tableName     String                @map("table_name")
  recordId      String                @map("record_id")
  operation     ContentDraftOperation
  payload       Json
  status        ContentDraftStatus    @default(pending)
  authorId      String                @map("author_id")
  reviewerId    String?               @map("reviewer_id")
  reviewComment String?               @map("review_comment")
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")
  author        AdminAccount          @relation("DraftAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  reviewer      AdminAccount?         @relation("DraftReviewer", fields: [reviewerId], references: [id])

  @@index([tableName, status])
  @@index([authorId, status])
  @@index([status, createdAt(sort: Desc)])
  @@map("content_drafts")
}

model MetricSnapshot {
  id         String   @id @default(uuid())
  metricName String   @map("metric_name")
  date       DateTime
  value      Float
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([metricName, date])
  @@index([metricName, date(sort: Desc)])
  @@map("metric_snapshots")
}

