generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String                @id @default(uuid())
  username          String                @unique
  email             String                @unique
  passwordHash      String?
  authProvider      String?
  providerId        String?
  walletAddress     String?
  ecosystemId       String?
  keeperLevel       Int                   @default(1)
  keeperXp          BigInt                @default(0)
  prestigeTokens    Int                   @default(0)
  flags             Json                  @default("{}")
  primaryLocationId String?
  bonusOutpostSlots Int                   @default(0)
  lastNftSyncAt     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  stripeCustomerId  String?
  activeEffects     ActiveEffect[]
  checkInInstances  CheckInInstance[]
  cryptoWithdrawals CryptoWithdrawal[]
  currencyLedger    CurrencyLedger[]
  entities          Entity[]
  giftInstances     GiftInstance[]
  itemInstances     ItemInstance[]        @relation("UserItemInstances")
  itemLedger        ItemLedger[]
  jobs              Job[]
  linkedWallets     LinkedWallet[]
  locationInstances LocationInstance[]
  notifications     Notification[]
  passwordResets    PasswordReset[]
  playerDeltas      PlayerDelta[]
  playerEvents      PlayerEvent[]
  purchases         Purchase[]
  questInstances    QuestInstance[]
  currencyBalances  UserCurrencyBalance[]

  @@unique([authProvider, providerId])
  @@index([ecosystemId])
  @@map("users")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_resets")
}

model LinkedWallet {
  id        String   @id @default(uuid())
  userId    String
  chain     String
  address   String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([chain, address])
  @@index([userId])
  @@map("linked_wallets")
}

model WalletNonce {
  id        String   @id @default(uuid())
  address   String
  chain     String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([chain, address])
  @@map("wallet_nonces")
}

model NftCollectionDef {
  id                   String     @id
  name                 String
  chain                String
  collectionId         String
  entityDefinitionId   String?
  locationDefinitionId String?
  mintMode             String     @default("one_per_token")
  active               Boolean    @default(true)
  data                 Json       @default("{}")
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  nftAssets            NftAsset[]

  @@unique([chain, collectionId])
  @@map("nft_collection_defs")
}

model SelectionRuleDef {
  id          String   @id
  name        String
  description String?
  tags        String[]
  selection   Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@map("selection_rule_defs")
}

model SynergyRule {
  id              String    @id
  name            String
  description     String?
  enabled         Boolean   @default(true)
  sourceSelector  Json      @default("{}")
  targetSelector  Json      @default("{}")
  context         Json      @default("{}")
  effects         Json
  priority        Int       @default(100)
  stackGroup      String?
  stackMode       StackMode @default(additive)
  maxApplications Int       @default(1)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
  @@map("synergy_rules")
}

model NftAsset {
  nftAssetId    String           @id
  collectionId  String
  chain         String
  policyId      String
  tokenName     String
  ownerAddress  String?
  name          String?
  imageUrl      String?
  rawMetadata   Json             @default("{}")
  nftAttributes Json             @default("{}")
  lastSyncedAt  DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  collection    NftCollectionDef @relation(fields: [collectionId], references: [id])

  @@index([collectionId])
  @@index([ownerAddress])
  @@map("nft_assets")
}

model Currency {
  id           String                @id
  name         String
  symbol       String?
  iconKey      String?
  type         CurrencyType
  seasonId     String?
  isTradeable  Boolean               @default(false)
  isSpendable  Boolean               @default(true)
  decimals     Int                   @default(0)
  cap          BigInt?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  enabled      Boolean               @default(true)
  showInTopBar             Boolean               @default(false)
  sortOrder                Int                   @default(0)
  cntEcosystem             String?
  cntWalletType            String?
  cntPolicyId              String?
  cntAssetName             String?
  cntPriceAda              Float?
  cntMinWithdrawalType     WithdrawalMinType?
  cntMinWithdrawalAmount   Float?
  cntWithdrawalFee         BigInt?
  cntAutoApprovalThreshold BigInt?
  ledger                   CurrencyLedger[]
  balances                 UserCurrencyBalance[]

  @@map("currencies")
}

model UserCurrencyBalance {
  userId     String
  currencyId String
  balance    BigInt   @default(0)
  updatedAt  DateTime @updatedAt
  currency   Currency @relation(fields: [currencyId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, currencyId])
  @@index([currencyId])
  @@index([userId])
  @@map("user_currency_balances")
}

model CurrencyLedger {
  id         BigInt   @id @default(autoincrement())
  userId     String
  currencyId String
  delta      BigInt
  reason     String
  sourceType String?
  sourceId   String?
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now())
  currency   Currency @relation(fields: [currencyId], references: [id])
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([currencyId, createdAt(sort: Desc)])
  @@map("currency_ledger")
}

model EntityDefinition {
  id             String   @id
  name           String
  speciesId      String
  slots          Json     @default("{}")
  equipmentSlots Json     @default("{}")
  traits         Json     @default("{}")
  rules          Json     @default("{}")
  data           Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  init           Json
  progression    Json
  ascension      Json
  mastery        Json
  entities       Entity[]

  @@index([speciesId])
  @@map("entity_definitions")
}

model Entity {
  id                 String                     @id @default(uuid())
  ownerUserId        String?
  ecosystemId        String?
  nftAssetId         String?                    @unique
  nftCollectionDefId String?
  definitionId       String
  speciesId          String
  role               String                     @default("player_unit")
  display            Json                       @default("{}")
  progression        Json                       @default("{}")
  stats              Json                       @default("{}")
  traits             Json                       @default("{}")
  archetypeVector    Json                       @default("{}")
  affinities         Json                       @default("{}")
  state              Json                       @default("{}")
  injuredUntilTick   Int?
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  definition         EntityDefinition           @relation(fields: [definitionId], references: [id])
  owner              User?                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  equipment          EntityEquipment[]
  powerUsages        EntityPowerUsage[]
  workerAssignments  LocationWorkerAssignment[]

  @@index([ownerUserId])
  @@index([ecosystemId])
  @@index([speciesId])
  @@index([definitionId])
  @@map("entities")
}

model EntityEquipment {
  id             String   @id @default(uuid())
  entityId       String
  itemInstanceId String
  slotClaims     Json     @default("[]")
  equippedAt     DateTime @default(now())
  entity         Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@map("entity_equipment")
}

model RegionDefinition {
  id                  String               @id
  displayName         String
  biome               String?
  imageKey            String?
  accentColor         String?
  modifiers           Json                 @default("{}")
  data                Json                 @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  locationDefinitions LocationDefinition[]

  @@map("region_definitions")
}

model LocationDefinition {
  id                     String             @id
  kind                   String             @default("outpost_fungible")
  regionId               String?
  isUnique               Boolean            @default(false)
  rules                  Json               @default("{}")
  productionProfile      Json               @default("{}")
  data                   Json               @default("{}")
  requirements           Json               @default("[]")
  visibilityRequirements Json               @default("[]")
  levelUpModalDefId      String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  region                 RegionDefinition?  @relation(fields: [regionId], references: [id])
  instances              LocationInstance[]

  @@index([regionId])
  @@map("location_definitions")
}

model BuildingDef {
  id                     String                     @id
  name                   String
  description            String?
  iconKey                String?
  category               String?
  tags                   Json                       @default("[]")
  rules                  Json                       @default("{}")
  data                   Json                       @default("{}")
  requirements           Json                       @default("[]")
  visibilityRequirements Json                       @default("[]")
  activeModalDefId       String?
  readyModalDefId        String?
  completedModalDefId    String?
  failedModalDefId       String?
  displayDefId           String?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
  displayDef             DisplayDef?                @relation(fields: [displayDefId], references: [id])
  buildingInstances      LocationBuildingInstance[]

  @@map("building_defs")
}

model RoomDef {
  id                     String                 @id
  name                   String
  description            String?
  tags                   Json                   @default("[]")
  rules                  Json                   @default("{}")
  data                   Json                   @default("{}")
  requirements           Json                   @default("[]")
  visibilityRequirements Json                   @default("[]")
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  roomInstances          LocationRoomInstance[]

  @@map("room_defs")
}

model LocationInstance {
  id                 String                     @id @default(uuid())
  ownerUserId        String?
  ecosystemId        String?
  nftAssetId         String?                    @unique
  definitionId       String
  regionId           String?
  kind               String                     @default("outpost_fungible")
  isUnique           Boolean                    @default(false)
  level              Int                        @default(1)
  xp                 BigInt                     @default(0)
  threatLevel        Int                        @default(0)
  corruptionLevel    Int                        @default(0)
  lastCollectionTick BigInt                     @default(0)
  storage            Json                       @default("{}")
  state              Json                       @default("{}")
  enabled            Boolean                    @default(true)
  version            Int                        @default(1)
  createdAt          DateTime                   @default(now())
  updatedAt          DateTime                   @updatedAt
  name               String?
  buildings          LocationBuildingInstance[]
  definition         LocationDefinition         @relation(fields: [definitionId], references: [id])
  owner              User?                      @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  powerUsages        LocationPowerUsage[]
  workerAssignments  LocationWorkerAssignment[]

  @@index([ownerUserId])
  @@index([ecosystemId])
  @@index([definitionId])
  @@map("location_instances")
}

model LocationBuildingInstance {
  id            String                 @id @default(uuid())
  locationId    String
  buildingDefId String
  level         Int                    @default(1)
  state         Json                   @default("{}")
  enabled       Boolean                @default(true)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  buildingDef   BuildingDef            @relation(fields: [buildingDefId], references: [id])
  location      LocationInstance       @relation(fields: [locationId], references: [id], onDelete: Cascade)
  rooms         LocationRoomInstance[]

  @@index([locationId])
  @@index([buildingDefId])
  @@map("location_building_instances")
}

model LocationRoomInstance {
  id                 String                   @id @default(uuid())
  buildingInstanceId String
  roomDefId          String
  level              Int                      @default(1)
  state              Json                     @default("{}")
  enabled            Boolean                  @default(true)
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  building           LocationBuildingInstance @relation(fields: [buildingInstanceId], references: [id], onDelete: Cascade)
  roomDef            RoomDef                  @relation(fields: [roomDefId], references: [id])

  @@index([buildingInstanceId])
  @@index([roomDefId])
  @@map("location_room_instances")
}

model LocationWorkerAssignment {
  id         String           @id @default(uuid())
  locationId String
  entityId   String
  roleTag    String           @default("production")
  bonus      Json             @default("{}")
  assignedAt DateTime         @default(now())
  entity     Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)
  location   LocationInstance @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([locationId, entityId])
  @@index([locationId])
  @@index([entityId])
  @@map("location_worker_assignments")
}

model IdempotencyKey {
  id           String   @id
  userId       String
  endpoint     String
  commandType  String   @default("")
  requestHash  String
  responseJson Json
  createdAt    DateTime @default(now())

  @@unique([userId, endpoint, id])
  @@unique([userId, commandType, id])
  @@index([userId, createdAt(sort: Desc)])
  @@map("idempotency_keys")
}

model PlayerDelta {
  id        BigInt   @id @default(autoincrement())
  userId    String
  patches   Json
  ui        Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@map("player_deltas")
}

model DisplayDef {
  id                  String               @id
  name                String
  borderColor         String?
  backgroundImage     String?
  cardBackground      String?
  style               Json                 @default("{}")
  data                Json                 @default("{}")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  buildingDefs        BuildingDef[]
  missionCategoryDefs MissionCategoryDef[]
  missionDefs         MissionDef[]
  recipeDefs          RecipeDef[]

  @@map("display_defs")
}

model MissionCategoryDef {
  id                     String               @id
  name                   String
  parentId               String?
  displayDefId           String?
  tags                   Json                 @default("[]")
  requirements           Json                 @default("[]")
  visibilityRequirements Json                 @default("[]")
  enabled                Boolean              @default(true)
  sortOrder              Int                  @default(0)
  inlineOnly             Boolean              @default(false)
  data                   Json                 @default("{}")
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  displayDef             DisplayDef?          @relation(fields: [displayDefId], references: [id])
  parent                 MissionCategoryDef?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children               MissionCategoryDef[] @relation("CategoryHierarchy")
  missionDefs            MissionDef[]

  @@map("mission_category_defs")
}

model MissionDef {
  id                     String              @id
  name                   String
  description            String?
  difficulty             Int                 @default(0)
  minSuccessChance       Int                 @default(0)
  maxSuccessChance       Int                 @default(100)
  injuryRate             Float?              @default(0)
  injuryRecoveryTicks    Int?                @default(0)
  timer                  Json                @default("{\"duration\": 0, \"skipable\": false, \"boostable\": true, \"skip_cost\": [], \"skip_type\": \"absolute\"}")
  tiers                  Json                @default("{}")
  success                Json?
  failure                Json?
  requirements           Json                @default("[]")
  visibilityRequirements Json                @default("[]")
  tags                   Json                @default("[]")
  rewardPreview          Json                @default("[]")
  cost                   Json                @default("[]")
  enabled                Boolean             @default(true)
  sortOrder              Int                 @default(0)
  inline                 Boolean             @default(false)
  inlineLabel            String?
  displayDefId           String?
  missionCategoryDefId   String?
  activeModalDefId       String?
  readyModalDefId        String?
  completedModalDefId    String?
  failedModalDefId       String?
  data                   Json                @default("{}")
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  launchRequirements     Json?
  leadInModalDefId       String?
  displayDef             DisplayDef?         @relation(fields: [displayDefId], references: [id])
  missionCategoryDef     MissionCategoryDef? @relation(fields: [missionCategoryDefId], references: [id])

  @@index([missionCategoryDefId])
  @@map("mission_defs")
}

model RecipeDef {
  id                     String      @id
  name                   String
  description            String?
  category               String?
  group                  String?
  cost                   Json        @default("[]")
  timer                  Json        @default("{\"duration\": 0, \"skipable\": false, \"boostable\": true, \"skip_cost\": [], \"skip_type\": \"absolute\"}")
  requirements           Json        @default("[]")
  effects                Json        @default("[]")
  visibilityRequirements Json        @default("[]")
  activeModalDefId       String?
  readyModalDefId        String?
  completedModalDefId    String?
  failedModalDefId       String?
  data                   Json        @default("{}")
  displayDefId           String?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt
  difficulty             Float       @default(0)
  multicraft             Json?
  tiers                  Json        @default("{}")
  displayDef             DisplayDef? @relation(fields: [displayDefId], references: [id])

  @@map("recipe_defs")
}

model Job {
  id          String   @id @default(uuid())
  userId      String
  ecosystemId String?
  type        JobType
  defId       String
  status      String   @default("active")
  timer       Json     @default("{}")
  team        Json     @default("[]")
  results     Json?
  data        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  readyAtTick Int?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ecosystemId])
  @@index([userId, type, status])
  @@index([type, status])
  @@index([defId])
  @@index([readyAtTick, status])
  @@map("jobs")
}

model TickRateInterval {
  id                String      @id @default(uuid())
  ticksPerSecond    Float       @default(1.0)
  effectiveFromTime DateTime
  effectiveFromTick Float
  boostEventId      String?
  createdAt         DateTime    @default(now())
  boostEvent        BoostEvent? @relation(fields: [boostEventId], references: [id])

  @@index([effectiveFromTime])
  @@map("tick_rate_intervals")
}

model BoostEvent {
  id           String             @id @default(uuid())
  name         String
  description  String?
  multiplier   Float
  startTime    DateTime
  endTime      DateTime
  status       String             @default("scheduled")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  percentBoost Float              @default(0)
  intervals    TickRateInterval[]

  @@index([status])
  @@index([startTime])
  @@map("boost_events")
}

model LocationPowerUsage {
  id                 String           @id @default(uuid())
  locationInstanceId String
  powerKey           String
  lastUsedUtcDay     String
  usageCount         Int              @default(1)
  locationInstance   LocationInstance @relation(fields: [locationInstanceId], references: [id], onDelete: Cascade)

  @@unique([locationInstanceId, powerKey])
  @@index([locationInstanceId])
  @@map("location_power_usages")
}

model EntityPowerUsage {
  id             String @id @default(uuid())
  entityId       String
  powerKey       String
  lastUsedUtcDay String
  usageCount     Int    @default(1)
  entity         Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, powerKey])
  @@index([entityId])
  @@map("entity_power_usages")
}

model ItemDefinition {
  id             String         @id
  type           ItemType
  rarity         ItemRarity     @default(COMMON)
  name           String
  description    String?
  iconKey        String?
  uiColor        String?
  category       ItemCategory   @default(MISC)
  groups         String[]       @default([])
  tags           String[]       @default([])
  stackable      Boolean        @default(false)
  maxStack       Int?
  uniqueInstance Boolean        @default(false)
  lootboxDefId   String?
  equipData      Json?
  passiveEffects Json?
  consumableData Json?
  data           Json?
  seasonId       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  instances      ItemInstance[]
  ledger         ItemLedger[]

  @@index([type])
  @@index([rarity])
  @@index([seasonId])
  @@map("item_defs")
}

model ItemInstance {
  id           String         @id @default(uuid())
  userId       String
  definitionId String
  quantity     Int            @default(1)
  state        Json?
  equippedToId String?
  bound        Boolean        @default(false)
  tradeLocked  Boolean        @default(false)
  data         Json?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  definition   ItemDefinition @relation(fields: [definitionId], references: [id])
  user         User           @relation("UserItemInstances", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([definitionId])
  @@index([equippedToId])
  @@map("item_instances")
}

model ItemLedger {
  id         BigInt         @id @default(autoincrement())
  userId     String
  itemId     String
  delta      BigInt
  reason     String
  sourceType String?
  sourceId   String?
  metadata   Json           @default("{}")
  createdAt  DateTime       @default(now())
  item       ItemDefinition @relation(fields: [itemId], references: [id])
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([itemId, createdAt(sort: Desc)])
  @@map("item_ledger")
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  type        String
  category    String
  priority    String
  title       String
  body        String
  deepLink    Json?     @default("{}")
  meta        Json      @default("{}")
  groupKey    String?
  sourceType  String?
  sourceId    String?
  createdAt   DateTime  @default(now())
  readAt      DateTime?
  dismissedAt DateTime?
  archivedAt  DateTime?
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sourceType, sourceId, type], name: "notifications_source_unique")
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, readAt])
  @@index([userId, archivedAt])
  @@index([userId, groupKey])
  @@index([category])
  @@map("notifications")
}

model EventDefinition {
  id          String   @id
  name        String
  version     Int      @default(1)
  kind        String   @default("system")
  handlerKey  String
  security    Json     @default("{}")
  inputSchema Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("event_definitions")
}

model ModalDef {
  id          String   @id
  name        String
  description String?
  version     Int      @default(1)
  spec        Json     @default("{}")
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("modal_defs")
}

model GiftDef {
  id           String   @id
  name         String
  version      Int      @default(1)
  presentation Json     @default("{}")
  claimRules   Json     @default("{}")
  rewardSpec   Json     @default("{}")
  instant      Boolean  @default(true)
  enabled      Boolean  @default(true)
  modalDefId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("gift_defs")
}

model GiftInstance {
  id             String     @id @default(uuid())
  userId         String
  giftDefId      String
  giftDefVersion Int
  status         GiftStatus @default(UNCLAIMED)
  createdAt      DateTime   @default(now())
  expiresAt      DateTime?
  sourceType     String?
  sourceId       String?
  idempotencyKey String?    @unique
  snapshot       Json
  claim          Json?
  claimTxId      String?    @unique
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("gift_instances")
}

model GiftClaimTx {
  id        String   @id @default(uuid())
  giftId    String   @unique
  userId    String
  status    String
  seed      String
  rolls     Json     @default("[]")
  grants    Json     @default("[]")
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("gift_claim_txs")
}

model LootboxDef {
  id          String   @id
  name        String
  description String?
  version     Int      @default(1)
  iconKey     String?
  outcomes    Json     @default("[]")
  rollCount   Int      @default(1)
