  seasonId        String?                             // optional link to a Season (substitutes title/endsAt)
  season          Season?   @relation(fields: [seasonId], references: [id], onDelete: SetNull)
  config          Json      @default("{}")            // { autoAdvanceMs?: number, tagline?: string, ... }

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status])
  @@index([startsAt])
  @@index([endsAt])
