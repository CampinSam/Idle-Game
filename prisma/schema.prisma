/// Idempotency guard: one row per processed on-chain tx hash.
/// Inserted inside the same transaction as the credit; unique PK
/// prevents double-credit even under concurrent pollers.
model ProcessedCryptoTx {
  txHash      String   @id
  processedAt DateTime @default(now())

  @@map("processed_crypto_txs")
}

model CryptoWalletConfig {
  id                     String   @id @default("default")
  hotWalletAddress       String   @default("")
  blockfrostProjectId    String   @default("")
  depositScanPage        Int      @default(0)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  hotWalletSkeyEncrypted String   @default("")

  @@map("crypto_wallet_configs")
}

model CryptoWithdrawal {
  id                 String           @id @default(uuid())
  userId             String
  currencyId         String
  amount             BigInt
  fee                BigInt           @default(0)
