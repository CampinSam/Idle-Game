generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StackMode {
  additive
  best_only
  highest_abs_only
  unique
}

enum PurchasePaymentMethod {
  STRIPE
  CRYPTO_EVM
  CRYPTO_CARDANO
}

enum PurchaseStatus {
  PENDING
  CONFIRMED
  FAILED
  EXPIRED
}

enum CurrencyType {
  SOFT
  HARD
  PREMIUM
  SEASONAL
  EVENT
  GUILD
  CRYPTO
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  REJECTED
  SENT
  FAILED
}

enum WithdrawalMinType {
  QUANTITY
  ADA_VALUE
  USD_VALUE
}

model User {
  id             String   @id @default(uuid())
  username       String   @unique
  email          String   @unique
  passwordHash   String?
  authProvider   String?
  providerId     String?
  walletAddress  String?
  ecosystemId    String?
  keeperLevel       Int      @default(1)
  keeperXp          BigInt   @default(0)
  prestigeTokens    Int      @default(0)
  flags             Json     @default("{}")
  primaryLocationId String?
  bonusOutpostSlots Int      @default(0)
  lastNftSyncAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stripeCustomerId   String?

  entities           Entity[]
  locationInstances  LocationInstance[]
  jobs               Job[]
  notifications      Notification[]
  currencyBalances   UserCurrencyBalance[]
  currencyLedger     CurrencyLedger[]
  itemInstances      ItemInstance[]     @relation("UserItemInstances")
  itemLedger         ItemLedger[]
  giftInstances      GiftInstance[]
  playerDeltas       PlayerDelta[]
  playerEvents       PlayerEvent[]
  checkInInstances   CheckInInstance[]
  questInstances     QuestInstance[]
  linkedWallets      LinkedWallet[]
  activeEffects      ActiveEffect[]
  passwordResets     PasswordReset[]
  purchases          Purchase[]
  cryptoWithdrawals  CryptoWithdrawal[]

  @@unique([authProvider, providerId])
  @@index([ecosystemId])
  @@map("users")
}

model PasswordReset {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_resets")
}

model LinkedWallet {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chain     String
  address   String
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([chain, address])
  @@index([userId])
  @@map("linked_wallets")
}

model WalletNonce {
  id        String   @id @default(uuid())
  address   String
  chain     String
  nonce     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([chain, address])
  @@map("wallet_nonces")
}

model NftCollectionDef {
  id                   String   @id
  name                 String
  chain                String
  collectionId         String
  entityDefinitionId   String?
  locationDefinitionId String?
  mintMode             String   @default("one_per_token")
  active               Boolean  @default(true)
  data                 Json     @default("{}")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  nftAssets            NftAsset[]

  @@unique([chain, collectionId])
  @@map("nft_collection_defs")
}

// ═══════════════════════════════════════════════════
// SELECTION RULE LIBRARY
// ═══════════════════════════════════════════════════

model SelectionRuleDef {
  id          String   @id
  name        String
  description String?
  tags        String[]
  selection   Json
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([enabled])
  @@map("selection_rule_defs")
}

// ═══════════════════════════════════════════════════
// SYNERGY RULES
// ═══════════════════════════════════════════════════

model SynergyRule {
  id              String    @id
  name            String
  description     String?
  enabled         Boolean   @default(true)

  // Selector: which source entities this rule applies to.
  // Supported fields: entityTypes, speciesIds, collections, traitsAny,
  // traitsAll, minTraitCount, entityIds, rarities, regions, locationTypes,
  // buildingTagsAny, missionTagsAny, factions.
  sourceSelector  Json      @default("{}")

  // Selector: which target entities trigger the rule when paired with a source.
  targetSelector  Json      @default("{}")

  // Activity context constraints: activityTypes, missionTypes,
  // missionTagsAny, regionIds, seasonIds, requiresTeamSizeMin/Max.
  context         Json      @default("{}")

  // Array of effect objects:
  // { type: "synergy_score_modifier"|"stat_modifier"|"duration_modifier"|
  //         "resource_yield_modifier"|"immunity", ...}
  effects         Json

  // Lower priority number = evaluated earlier. Default 100.
  priority        Int       @default(100)

  // Group name for cross-rule stack behaviour (e.g. "trait_pair_synergy").
  stackGroup      String?

  // How multiple matching pairs/rules in the same stackGroup are handled.
  stackMode       StackMode @default(additive)

  // Max number of times this rule may apply (per resolver call).
  maxApplications Int       @default(1)

  // Optional date-gate. Rule only fires when now is within [startsAt, endsAt].
  startsAt        DateTime?
  endsAt          DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([enabled])
  @@map("synergy_rules")
}

model NftAsset {
  nftAssetId    String    @id
  collectionId  String
  chain         String
  policyId      String
  tokenName     String
  ownerAddress  String?
  name          String?
  imageUrl      String?
  rawMetadata   Json      @default("{}")
  nftAttributes Json      @default("{}")
  lastSyncedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  collection    NftCollectionDef @relation(fields: [collectionId], references: [id])

  @@index([collectionId])
  @@index([ownerAddress])
  @@map("nft_assets")
}

model Currency {
  id           String       @id
  name         String
  symbol       String?
  iconKey      String?
  type         CurrencyType
  seasonId     String?
  isTradeable  Boolean      @default(false)
  isSpendable  Boolean      @default(true)
  decimals     Int          @default(0)
  cap          BigInt?
  enabled      Boolean      @default(true)
  showInTopBar Boolean      @default(false)
  sortOrder    Int          @default(0)

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  balances    UserCurrencyBalance[]
  ledger      CurrencyLedger[]

  @@map("currencies")
}

model UserCurrencyBalance {
  userId     String
  currencyId String
  balance    BigInt      @default(0)
  updatedAt  DateTime    @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency   Currency    @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@id([userId, currencyId])
  @@index([currencyId])
  @@index([userId])
  @@map("user_currency_balances")
}

model CurrencyLedger {
  id         BigInt     @id @default(autoincrement())
  userId     String
  currencyId String

  delta      BigInt
  reason     String
  sourceType String?
  sourceId   String?
  metadata   Json       @default("{}")
  createdAt  DateTime   @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  currency   Currency   @relation(fields: [currencyId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt(sort: Desc)])
  @@index([currencyId, createdAt(sort: Desc)])
  @@map("currency_ledger")
}

// ═══════════════════════════════════════════════════
// ENTITY (CHARACTER) DEFINITION TABLES
// ═══════════════════════════════════════════════════

model EntityDefinition {
  id                String   @id
  name              String
  speciesId         String

  // Body slot layout: { slotName: [allowedArchetype, ...] }
  slots             Json     @default("{}")

  // Equipment slot capacities: { slotName: maxCount }
  equipmentSlots    Json     @default("{}")

  // Trait map keyed by archetype name:
  // { archetype: { slotStats, tags, emoji, color, gradient, scaling, rarityMultiplier, rarity } }
  traits            Json     @default("{}")

  // Progression rules: { enabled, maxLevel, xpCurve, statGain? }.
  // Required — no schema default; seeds and admin writes must supply a
  // complete object. Validated at seed time by validateEntityDefinition.
  progression       Json
  // Ascension rules: { enabled, cap?, costPerStep?, effects? } (gameplay TBD).
  ascension         Json
  // Mastery rules: { enabled, branches? } (gameplay TBD).
  mastery           Json
  // Initialization rules: { scratch: { startingLevel, baseStats, slotFill },
  //                         nft?: { attributeMap, missingSlotPolicy, defaults } }.
  // Required — no schema default; seeds and admin writes must supply scratch.
  init              Json

  rules             Json     @default("{}")
  data              Json     @default("{}")

  entities          Entity[]

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([speciesId])
  @@map("entity_definitions")
}

// ═══════════════════════════════════════════════════
// ENTITY (CHARACTER) INSTANCE TABLES
// ═══════════════════════════════════════════════════

model Entity {
  id                 String   @id @default(uuid())
  ownerUserId        String?
  ecosystemId        String?
  nftAssetId         String?  @unique
  nftCollectionDefId String?

  definitionId    String
  speciesId       String
  role            String   @default("player_unit")

  display         Json     @default("{}")
  progression     Json     @default("{}")
  stats           Json     @default("{}")
  traits          Json     @default("{}")
  archetypeVector Json     @default("{}")
  affinities      Json     @default("{}")
  state           Json     @default("{}")

  injuredUntilTick Int?

  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User?            @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  definition      EntityDefinition @relation(fields: [definitionId], references: [id])

  equipment       EntityEquipment[]
  workerAssignments LocationWorkerAssignment[]
  powerUsages     EntityPowerUsage[]

  @@index([ownerUserId])
  @@index([ecosystemId])
  @@index([speciesId])
  @@index([definitionId])
  @@map("entities")
}

model EntityEquipment {
  id              String   @id @default(uuid())
  entityId        String
  itemInstanceId  String
  slotClaims      Json     @default("[]")
  equippedAt      DateTime @default(now())

  entity          Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@map("entity_equipment")
}

// ═══════════════════════════════════════════════════
// LOCATION / OUTPOST DEFINITION TABLES
// ═══════════════════════════════════════════════════

model RegionDefinition {
  id          String   @id
  displayName String
  biome       String?
  imageKey    String?
  accentColor String?
  modifiers   Json     @default("{}")
  data        Json     @default("{}")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  locationDefinitions LocationDefinition[]

  @@map("region_definitions")
}

model LocationDefinition {
  id                       String   @id
  kind                     String   @default("outpost_fungible")
  regionId                 String?
  isUnique                 Boolean  @default(false)
  rules                    Json     @default("{}")
  productionProfile        Json     @default("{}")
  data                     Json     @default("{}")
  requirements             Json     @default("[]")
  visibilityRequirements   Json     @default("[]")
  levelUpModalDefId        String?

  region            RegionDefinition? @relation(fields: [regionId], references: [id], onDelete: SetNull)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  instances         LocationInstance[]

  @@index([regionId])
  @@map("location_definitions")
}

model BuildingDef {
  id                       String   @id
  name                     String
  description              String?
  iconKey                  String?
  category                 String?
  tags                     Json     @default("[]")
  rules                    Json     @default("{}")
  data                     Json     @default("{}")
  requirements             Json     @default("[]")
  visibilityRequirements   Json     @default("[]")
  activeModalDefId         String?
  readyModalDefId          String?
  completedModalDefId      String?
  failedModalDefId         String?
  displayDefId             String?
  displayDef               DisplayDef? @relation(fields: [displayDefId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  buildingInstances    LocationBuildingInstance[]

  @@map("building_defs")
}

model RoomDef {
  id                       String   @id
  name                     String
  description              String?
  tags                     Json     @default("[]")
  rules                    Json     @default("{}")
  data                     Json     @default("{}")
  requirements             Json     @default("[]")
  visibilityRequirements   Json     @default("[]")

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomInstances    LocationRoomInstance[]

  @@map("room_defs")
}

// ═══════════════════════════════════════════════════
// LOCATION / OUTPOST INSTANCE TABLES
// ═══════════════════════════════════════════════════

model LocationInstance {
  id              String   @id @default(uuid())
  ownerUserId     String?
  ecosystemId     String?
  nftAssetId      String?  @unique

  definitionId    String
  regionId        String?
  name            String?
  kind            String   @default("outpost_fungible")
  isUnique        Boolean  @default(false)

  level           Int      @default(1)
  xp              BigInt   @default(0)

  threatLevel     Int      @default(0)
  corruptionLevel Int      @default(0)

  lastCollectionTick BigInt @default(0)

  storage         Json     @default("{}")
  state           Json     @default("{}")
  enabled         Boolean  @default(true)

  version         Int      @default(1)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner           User?              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  definition      LocationDefinition @relation(fields: [definitionId], references: [id])

  buildings       LocationBuildingInstance[]
  workerAssignments LocationWorkerAssignment[]
  powerUsages     LocationPowerUsage[]

  @@index([ownerUserId])
  @@index([ecosystemId])
  @@index([definitionId])
  @@map("location_instances")
}

model LocationBuildingInstance {
  id              String   @id @default(uuid())
  locationId      String
  buildingDefId   String
  level           Int      @default(1)
  state           Json     @default("{}")
  enabled         Boolean  @default(true)

  location        LocationInstance @relation(fields: [locationId], references: [id], onDelete: Cascade)
  buildingDef     BuildingDef      @relation(fields: [buildingDefId], references: [id], onDelete: Restrict)
  rooms           LocationRoomInstance[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([locationId])
  @@index([buildingDefId])
  @@map("location_building_instances")
}

model LocationRoomInstance {
  id                  String   @id @default(uuid())
  buildingInstanceId  String
  roomDefId           String
  level               Int      @default(1)
  state               Json     @default("{}")
  enabled             Boolean  @default(true)

  building            LocationBuildingInstance @relation(fields: [buildingInstanceId], references: [id], onDelete: Cascade)
  roomDef             RoomDef          @relation(fields: [roomDefId], references: [id], onDelete: Restrict)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([buildingInstanceId])
  @@index([roomDefId])
  @@map("location_room_instances")
}

model LocationWorkerAssignment {
  id         String   @id @default(uuid())
  locationId String
  entityId   String
  roleTag    String   @default("production")
  bonus      Json     @default("{}")
  assignedAt DateTime @default(now())

  location   LocationInstance @relation(fields: [locationId], references: [id], onDelete: Cascade)
  entity     Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([locationId, entityId])
  @@index([locationId])
  @@index([entityId])
  @@map("location_worker_assignments")
}

// ═══════════════════════════════════════════════════
// EXISTING MODELS (unchanged)
// ═══════════════════════════════════════════════════

model IdempotencyKey {
  id           String   @id
  userId       String
  endpoint     String
  commandType  String   @default("")
  requestHash  String
  responseJson Json
  createdAt    DateTime @default(now())

  @@unique([userId, endpoint, id])
  @@unique([userId, commandType, id])
  @@index([userId, createdAt(sort: Desc)])
  @@map("idempotency_keys")
}

model PlayerDelta {
  id        BigInt   @id @default(autoincrement())
  userId    String
  patches   Json
  ui        Json?
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, id])
  @@map("player_deltas")
}

model DisplayDef {
  id              String   @id
  name            String
  borderColor     String?
  backgroundImage String?
  cardBackground  String?
  style           Json     @default("{}")
  data            Json     @default("{}")

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  missionCategoryDefs MissionCategoryDef[]
  missionDefs         MissionDef[]
  buildingDefs        BuildingDef[]
  recipeDefs          RecipeDef[]

  @@map("display_defs")
}

model MissionCategoryDef {
  id                       String      @id
  name                     String
  parentId                 String?
  parent                   MissionCategoryDef?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children                 MissionCategoryDef[] @relation("CategoryHierarchy")
  displayDefId             String?
  displayDef               DisplayDef? @relation(fields: [displayDefId], references: [id], onDelete: SetNull)
  tags                     Json        @default("[]")
  requirements             Json        @default("[]")
  visibilityRequirements   Json        @default("[]")
  enabled                  Boolean     @default(true)
  sortOrder                Int         @default(0)
  inlineOnly               Boolean     @default(false)
  data                     Json        @default("{}")

  createdAt                DateTime    @default(now())
  updatedAt                DateTime    @updatedAt

  missionDefs              MissionDef[]

  @@map("mission_category_defs")
}

model MissionDef {
  id                       String             @id
  name                     String
  description              String?
  difficulty               Int                @default(0)
  minSuccessChance         Int                @default(0)
  maxSuccessChance         Int                @default(100)
  injuryRate               Float?             @default(0)
  injuryRecoveryTicks      Int?               @default(0)
  timer                    Json               @default("{\"duration\":0,\"boostable\":true,\"skipable\":false,\"skip_cost\":[],\"skip_type\":\"absolute\"}")
  success                  Json               @default("{\"rewards\":[],\"effects\":[],\"text\":[]}")
  failure                  Json               @default("{\"rewards\":[],\"effects\":[],\"text\":[]}")
  requirements             Json               @default("[]")
  launchRequirements       Json?
  visibilityRequirements   Json               @default("[]")
  tags                     Json               @default("[]")
  rewardPreview            Json               @default("[]")
  cost                     Json               @default("[]")
  enabled                  Boolean            @default(true)
  sortOrder                Int                @default(0)
  inline                   Boolean            @default(false)
  inlineLabel              String?
  displayDefId             String?
  displayDef               DisplayDef?        @relation(fields: [displayDefId], references: [id], onDelete: SetNull)
  missionCategoryDefId     String?
  missionCategoryDef       MissionCategoryDef? @relation(fields: [missionCategoryDefId], references: [id], onDelete: SetNull)
  activeModalDefId         String?
  readyModalDefId          String?
  completedModalDefId      String?
  failedModalDefId         String?
  leadInModalDefId         String?
  data                     Json               @default("{}")

  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  @@index([missionCategoryDefId])
  @@map("mission_defs")
}

model RecipeDef {
  id                       String   @id
  name                     String
  description              String?
  category                 String?
  group                    String?
  cost                     Json     @default("[]")
  timer                    Json     @default("{\"duration\":0,\"boostable\":true,\"skipable\":false,\"skip_cost\":[],\"skip_type\":\"absolute\"}")
  difficulty               Float    @default(0)
  tiers                    Json     @default("{}")
  multicraft               Json?
  requirements             Json     @default("[]")
  effects                  Json     @default("[]")
  visibilityRequirements   Json     @default("[]")
  activeModalDefId         String?
  readyModalDefId          String?
  completedModalDefId      String?
  failedModalDefId         String?
  data                     Json     @default("{}")
  displayDefId             String?
  displayDef               DisplayDef? @relation(fields: [displayDefId], references: [id], onDelete: SetNull)

  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("recipe_defs")
}

enum JobType {
  MissionJob
  CraftingJob
  BuildingJob
}

model Job {
  id            String   @id @default(uuid())
  userId        String
  ecosystemId   String?
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          JobType
  defId         String
  status        String   @default("active")
  timer         Json     @default("{}")
  team          Json     @default("[]")
  results       Json?
  data          Json     @default("{}")
  readyAtTick   Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
  @@index([ecosystemId])
  @@index([userId, type, status])
  @@index([type, status])
  @@index([defId])
  @@index([readyAtTick, status])
  @@map("jobs")
}

model TickRateInterval {
  id                String   @id @default(uuid())
  ticksPerSecond    Float    @default(1.0)
  effectiveFromTime DateTime
  effectiveFromTick Float
  boostEventId      String?
  boostEvent        BoostEvent? @relation(fields: [boostEventId], references: [id])
  createdAt         DateTime @default(now())

  @@index([effectiveFromTime])
  @@map("tick_rate_intervals")
}

model BoostEvent {
  id           String   @id @default(uuid())
  name         String
  description  String?
  multiplier   Float
  percentBoost Float    @default(0)
  startTime    DateTime
  endTime      DateTime
  status       String   @default("scheduled")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  intervals    TickRateInterval[]

  @@index([status])
  @@index([startTime])
  @@map("boost_events")
}

model LocationPowerUsage {
  id                 String           @id @default(uuid())
  locationInstanceId String
  powerKey           String
  lastUsedUtcDay     String
  usageCount         Int              @default(1)

  locationInstance   LocationInstance @relation(fields: [locationInstanceId], references: [id], onDelete: Cascade)

  @@unique([locationInstanceId, powerKey])
  @@index([locationInstanceId])
  @@map("location_power_usages")
}

model EntityPowerUsage {
  id             String @id @default(uuid())
  entityId       String
  powerKey       String
  lastUsedUtcDay String
  usageCount     Int    @default(1)

  entity         Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@unique([entityId, powerKey])
  @@index([entityId])
  @@map("entity_power_usages")
}

enum ItemRarity {
  COMMON
  UNCOMMON
  SCARE
  RARE
  EPIC
  MYTHIC
  LEGENDARY
  UNIQUE
}

enum ItemType {
  MATERIAL
  CONSUMABLE
  GEAR
  QUEST
  LOOTBOX
  GIFT_PACKAGE
}

enum ItemCategory {
  MISC
  CRAFTING
  COMBAT
  EXPLORATION
  QUEST_ITEMS
  ENHANCEMENT
}

model ItemDefinition {
  id              String       @id

  type            ItemType
  rarity          ItemRarity   @default(COMMON)

  name            String
  description     String?
  iconKey         String?
  uiColor         String?
  category        ItemCategory @default(MISC)
  groups          String[]     @default([])

  tags            String[]     @default([])

  stackable       Boolean      @default(false)
  maxStack        Int?

  uniqueInstance  Boolean      @default(false)

  lootboxDefId    String?

  equipData       Json?
  passiveEffects  Json?
  consumableData  Json?
  data            Json?

  seasonId        String?

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  instances       ItemInstance[]
  ledger          ItemLedger[]

  @@index([type])
  @@index([rarity])
  @@index([seasonId])
  @@map("item_defs")
}

model ItemInstance {
  id             String   @id @default(uuid())

  userId         String
  user           User     @relation("UserItemInstances", fields: [userId], references: [id], onDelete: Cascade)

  definitionId   String
  definition     ItemDefinition @relation(fields: [definitionId], references: [id])

  quantity       Int      @default(1)

  state          Json?

  equippedToId   String?

  bound          Boolean  @default(false)

  tradeLocked    Boolean  @default(false)

  data           Json?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

