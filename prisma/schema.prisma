// ═══════════════════════════════════════════════════
// QUEST SYSTEM
// ═══════════════════════════════════════════════════

model QuestDef {
  id           String   @id
  name         String
  description  String?
  // Known category values: "achievement" (lifetime one-shot), "daily",
  // "weekly", "story", "oneoff". "achievement" defs absorbed from the old
  // AchievementDef table; they use cadence="oneoff", repeatable=false, and
  // may carry a permanentEffectSpec applied on claim.
  category     String?
  // Reset cadence: "daily" rolls over at UTC 00:00, "weekly" at UTC Monday
  // 00:00, "oneoff" never auto-resets (default — preserves legacy quest
  // semantics). Daily/weekly imply repeatable; the QuestService treats them
  // as repeatable on claim regardless of the `repeatable` flag below.
  cadence      String   @default("oneoff")
  objectives   Json     @default("[]")
  rewardSpec   Json     @default("{}")
  // Optional ActiveEffect template to grant permanently on claim. Shape:
  // { effectDefId, targetType, targetId?, value?, stats? }. Omit to grant
  // only the rewardSpec. Primarily used for category="achievement" defs.
  permanentEffectSpec Json?
  requirements Json     @default("[]")
  repeatable   Boolean  @default(false)
  enabled      Boolean  @default(true)
  sortOrder    Int      @default(0)
  // Tier hint for UI ordering/cosmetics. 1=bronze, 2=silver, 3=gold etc.
  // Meaningful for category="achievement" defs; ignored for other categories.
  tier         Int      @default(1)
  version      Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  instances    QuestInstance[]

  @@index([cadence, enabled])
  @@index([category, enabled])
  @@map("quest_defs")
}

model QuestInstance {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questDefId      String
  questDef        QuestDef  @relation(fields: [questDefId], references: [id], onDelete: Cascade)
  progress        Json      @default("[]")
  status          String    @default("active")
  // Start of the current cadence window (UTC 00:00 for daily, UTC Monday
  // 00:00 for weekly). Null for one-off quests. Used to detect when the
  // window has rolled over and progress should be reset on next read/event.
  windowStartedAt DateTime?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  claimedAt       DateTime?

  @@unique([userId, questDefId])
  @@index([userId, status])
  @@map("quest_instances")
}


