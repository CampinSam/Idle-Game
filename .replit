modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]
[agent]
expertMode = true
integrations = ["javascript_object_storage:2.0.0"]

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
JWT_SECRET = "replit-dev-jwt-secret-change-in-production"
JWT_EXPIRES_IN = "7d"

[userenv.development]
NODE_ENV = "development"
API_PORT = "3001"

[userenv.production]
NODE_ENV = "production"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bash /home/runner/workspace/start.sh"
waitForPort = 5000

[[ports]]
localPort = 3001
externalPort = 3001

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3000


[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "NODE_ENV=production PORT=5000 node apps/api/dist/main.js"]
build = ["bash", "-c", "pnpm install --frozen-lockfile && node scripts/prisma-deploy.js && npx prisma generate --schema=prisma/schema.prisma && pnpm --filter @derp/shared build && pnpm --filter @derp/math build && pnpm --filter @derp/web build && pnpm --filter @derp/api build"]

[objectStorage]
defaultBucketID = "replit-objstore-bdb73ea8-5bc7-48a6-859f-1e1c58b98d1c"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
