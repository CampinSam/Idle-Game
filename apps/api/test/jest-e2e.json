{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "roots": ["<rootDir>"],
  "testMatch": ["**/*.e2e-spec.ts"],
  "moduleNameMapper": {
    "^@derp/math$": "<rootDir>/../../../packages/math/src/index.ts",
    "^@derp/shared$": "<rootDir>/../../../packages/shared/src/index.ts"
  },
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "diagnostics": false,
      "tsconfig": {
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "strict": false
      }
    }]
  }
}
