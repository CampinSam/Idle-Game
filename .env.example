# Database
DATABASE_URL="postgresql://derp:derp_dev_password@localhost:5432/derp_universe"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
JWT_SECRET="change-me-in-production-please"
JWT_EXPIRES_IN="7d"

# Password recovery — optional, enables email delivery of reset links
# Sign up at https://resend.com to get an API key
RESEND_API_KEY=""
EMAIL_FROM="Derp Universe <noreply@derp.game>"
# Public URL of the frontend (used to build reset links in emails)
APP_URL="https://your-app.replit.app"

# Server
PORT=3001
NODE_ENV=development
