{
  "name": "derp-universe",
  "version": "0.1.0",
  "private": true,
  "description": "Derp Universe - Season-based Idle Strategy RPG",
  "scripts": {
    "dev": "pnpm --parallel -r dev",
    "dev:api": "pnpm --filter @derp/api dev",
    "dev:web": "pnpm --filter @derp/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @derp/api test:e2e",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm -r lint:fix",
    "prisma:generate": "pnpm --filter @derp/api prisma:generate",
    "prisma:migrate": "pnpm --filter @derp/api prisma:migrate",
    "prisma:studio": "pnpm --filter @derp/api prisma:studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "bcrypt",
      "esbuild",
      "prisma",
      "@prisma/client",
      "@prisma/engines",
      "@nestjs/core"
    ]
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "bcrypt": "^5.1.1",
    "prisma": "5.22.0",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.19.0",
    "@prisma/client": "5.22.0",
    "google-auth-library": "^10.5.0",
    "pg": "^8.13.0"
  }
}
